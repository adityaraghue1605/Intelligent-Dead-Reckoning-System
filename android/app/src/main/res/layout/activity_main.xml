<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0D14">

    <!-- Top App & Mode Switcher Bar -->
    <LinearLayout
        android:id="@+id/top_control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F172A"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Title & Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛰️ IDR Navigator"
                android:textColor="#00F2FE"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_nav_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GNSS AIDED"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#151E2E"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_settings_server"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="⚙️"
                android:textSize="14sp"
                android:backgroundTint="#1E293B"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Segmented Mode Tabs (Web Dashboard vs AMOLED HUD) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="#1E293B"
            android:layout_marginTop="8dp"
            android:padding="2dp">

            <Button
                android:id="@+id/btn_tab_web"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🌐 Web System &amp; Map"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#00F2FE"
                android:backgroundTint="#0F172A"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_tab_hud"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚡ AMOLED HUD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:backgroundTint="#1E293B"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Container Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Mode A: Embedded Web System View -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Mode B: Native AMOLED Cockpit HUD -->
        <LinearLayout
            android:id="@+id/layout_native_hud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Speedometer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#121826"
                android:padding="24dp"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VEHICLE SPEED"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="#00F2FE"
                    android:textSize="54sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h (AI Estimated)"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Metrics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- Heading -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#121826"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEADING"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_heading_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="000°"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Drift Target -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#121826"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DRIFT (&lt;10% TARGET)"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_drift_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0%"
                        android:textColor="#10B981"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Coordinates & Drift Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#121826"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTIMATED COORDINATES"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_coordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="52.431630, -1.525745"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_drift_meters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 m drift"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Outage Simulator Action Button -->
            <Button
                android:id="@+id/btn_simulate_tunnel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Simulate Tunnel Blackout"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EF4444"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
